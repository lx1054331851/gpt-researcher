OPENAI_API_KEY=
TAVILY_API_KEY=
DOC_PATH=./my-docs
LANGUAGE=chinese  # 报告输出语言，默认 english，可设为 chinese、japanese 等
WORD_EXPORT_FONTS=仿宋,FangSong,STFangsong  # Word 导出字体优先级（逗号分隔）

# NEXT_PUBLIC_GPTR_API_URL=http://0.0.0.0:8000  # 未设置时默认为 localhost:8000

# 爬虫配置
# --------
# 控制并发爬取数量和请求限速，以遵守各 API 的调用限制

# 最大并发爬虫数（同时执行的操作数）
# 请根据你使用的爬虫服务限制进行调整：
#   - Firecrawl 免费版：2 个并发浏览器
#   - Firecrawl Hobby 版：5 个并发浏览器
#   - BeautifulSoup 等其他爬虫：根据目标站点限制设置
# 默认值：15（对有频率限制的 API 可能过高）
#MAX_SCRAPER_WORKERS=15

# 限速：相邻两次爬虫请求之间的最小间隔秒数
# 控制请求频率，避免超出 API 速率限制
# 计算方式：60 / 每分钟请求数
# 示例：
#   - Firecrawl 免费版（10 次/分钟）：6.0 秒
#   - Firecrawl /scrape（10 次/分钟）：6.0 秒
#   - 自定义 API（30 次/分钟）：2.0 秒
#   - 不限速：0（默认）
# 说明：适用于所有爬虫类型（firecrawl、bs、browser 等）
# 默认值：0.0（不限速）
#SCRAPER_RATE_LIMIT_DELAY=0.0

# 性能优化
# --------
# 智能上下文压缩：对小文档跳过高开销的 embedding 过滤
# 当抓取内容已经较精简时，可直接使用内容，避免进入压缩流水线
# 在小结果集查询场景下可降低约 40-50% 延迟
# 默认值：8000 字符（8KB 阈值）
#COMPRESSION_THRESHOLD=8000

# 自适应深度研究（Adaptive Deep Research v2）
#DEEP_RESEARCH_MODE=fixed                 # fixed | adaptive
#ADAPTIVE_MIN_DEPTH=1
#ADAPTIVE_MAX_DEPTH=5
#ADAPTIVE_RUN_TIMEOUT_SECONDS=1800        # 全局运行超时（秒），质量优先但避免无限挂起
#ADAPTIVE_QUALITY_THRESHOLD=7.5
#ADAPTIVE_SEARCH_TIMEOUT_SECONDS=30       # 单次检索/抓取超时（秒）
#ADAPTIVE_QUERY_MATRIX_TIMEOUT_SECONDS=25 # 生成 query matrix 的超时（秒）
#ADAPTIVE_CLAIM_EXTRACTION_TIMEOUT_SECONDS=35 # claim 抽取超时（秒）
#ADAPTIVE_MAX_CONSECUTIVE_EMPTY_ROUNDS=2  # 连续空轮次达到后提前结束该节点
#ADAPTIVE_MAX_CONFLICTS_PER_NODE=2        # 每个节点最多处理冲突数
#ADAPTIVE_MAX_DIMENSIONS=10               # 规划阶段最多保留的研究维度数
#ADAPTIVE_SOURCE_QUALITY_FILTER_ENABLED=true
#ADAPTIVE_MAX_SOURCES_PER_QUERY=5
#ADAPTIVE_MAX_SOURCES_PER_DOMAIN=2
#ADAPTIVE_MIN_SOURCE_QUALITY_SCORE=0.0
#ADAPTIVE_REQUIRE_HIGH_QUALITY_SOURCE_QUOTA=true
#ADAPTIVE_HIGH_QUALITY_SOURCE_QUOTA=0.5
#ADAPTIVE_HIGH_QUALITY_DOMAINS=["www.vfc.com","www.sec.gov","www.wsj.com","www.reuters.com","www.bloomberg.com","www.ft.com"]
#ADAPTIVE_LOW_QUALITY_DOMAINS=["www.accio.com","www.msn.com","www.stocktitan.net","live.worldtourismforum.net"]
#ADAPTIVE_CACHE_ENABLED=true
#ADAPTIVE_MAX_ROUNDS_PER_NODE=2
#ADAPTIVE_MAX_QUERIES_PER_ROUND=3         # 每轮最多执行查询数（质量优先）
#ADAPTIVE_MAX_QUERY_FAILURES_PER_NODE=3   # 节点连续失败轮次上限，超限提前停止
#ADAPTIVE_FAILURE_RATE_REDUCE_THRESHOLD=0.8 # 失败比例超过阈值时自动降载
#ADAPTIVE_QUERY_MATRIX_LLM_DISABLE_AFTER_FAILURES=3 # query matrix 多次失败后走规则回退
#ADAPTIVE_CLAIM_LLM_DISABLE_AFTER_FAILURES=4 # claim 抽取多次失败后走规则回退
#ADAPTIVE_FAILED_DOMAIN_THRESHOLD=2        # 域名达到失败阈值后本轮屏蔽
#ADAPTIVE_MIN_COMPLETED_NODES_FOR_EARLY_STOP=4
#ENTROPY_MIN_GAIN=0.08
#SALIENCY_THRESHOLD=0.72
#RABBIT_HOLE_MAX_BRANCHES=2
#RABBIT_HOLE_MAX_QUERIES_PER_BRANCH=3
#TAVILY_SEARCH_DEPTH_DEFAULT=basic        # basic | advanced
#TAVILY_ADVANCED_ENABLED=false
#REPORT_COMPLETION_GUARD_ENABLED=true     # 开启报告完整性守卫（自动补全截断）
#REPORT_COMPLETION_MAX_ATTEMPTS=2         # 自动续写补全次数
#REPORT_COMPLETION_REQUIRE_MARKER=true    # 要求模型输出完成标记（内部校验）
#REPORT_SECTIONAL_FALLBACK_ENABLED=true   # 整篇+续写仍不完整时，自动分节重写
#REPORT_SECTIONAL_MAX_SECTIONS=6          # 分节重写的最大章节数
#REPORT_SECTIONAL_CONTEXT_CHARS=24000     # 分节写作使用的上下文字符上限
#REPORT_SECTIONAL_PREFLIGHT_ENABLED=true  # 长上下文或 deep 模式时，优先直接分节生成
#REPORT_SECTIONAL_PREFLIGHT_MIN_CONTEXT_CHARS=14000  # 触发预判分节的上下文长度阈值
#REPORT_SECTIONAL_TIMEOUT_SECONDS=180      # 分节路径单次总超时，超时后回到主路径
#REPORT_SECTIONAL_FALLBACK_REDUCED_MAX_SECTIONS=4    # preflight 传输失败时的降级章节数
#REPORT_SECTIONAL_FALLBACK_REDUCED_CONTEXT_CHARS=12000 # preflight 传输失败时的降级上下文

# LangChain 链路追踪（LangSmith）- 开启后可增强可观测性
# 如需启用追踪，请取消以下注释并填入你的 API Key

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT="gpt-researcher"

# =============================================
# Azure OpenAI 配置（使用 Azure 时取消注释）
# =============================================
# AZURE_OPENAI_API_KEY=                          # Azure OpenAI API 密钥
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/  # 你的 Azure 端点
# AZURE_OPENAI_API_VERSION=2024-05-01-preview    # 推荐：Azure OpenAI API 版本
# OPENAI_API_VERSION=2024-05-01-preview          # 兼容写法（二选一即可）

# LLM 模型（格式：azure_openai:<部署名称>，部署名称需与 Azure 后台一致）
# FAST_LLM=azure_openai:gpt-4o-mini              # 快速/轻量任务使用的模型
# SMART_LLM=azure_openai:gpt-4o                  # 复杂推理任务使用的模型
# STRATEGIC_LLM=azure_openai:o1-preview          # 战略规划任务使用的模型

# Embedding 模型
# EMBEDDING=azure_openai:text-embedding-3-large  # 向量嵌入模型
